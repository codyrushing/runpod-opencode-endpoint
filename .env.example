# Copy to .env and fill in. Loaded automatically by scripts/lib.sh.

# RunPod API key, used by all deploy/destroy/status/ping scripts.
RUNPOD_API_KEY=rpa_...

# Container registry path where ./scripts/build.sh pushes baked images, and
# where deploy.sh tells RunPod to pull them from. The full image name is
# `${REGISTRY}/<repo>:<tag>` per the manifests in endpoints/.
#
# Examples:
#   REGISTRY=ghcr.io/your-github-user      # GitHub Container Registry (recommended)
#   REGISTRY=docker.io/your-dockerhub-user # Docker Hub
#
# You must `docker login` to whichever registry you pick before running build.sh.
REGISTRY=ghcr.io/your-user
